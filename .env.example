APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=39057
# NeoFlow host port; the container still listens on 39057.
APP_PUBLISH_PORT=39022
APP_BASE_PATH=/weekly-assistant
PUBLIC_BASE_URL=https://neoflow-cn.neo-net.com/weekly-assistant
ADMIN_API_TOKEN=replace-with-a-long-random-token
PUBLIC_LINK_SECRET=replace-with-another-long-random-secret
PUBLIC_LINK_LIFETIME_DAYS=30

# Existing DingTalk enterprise internal application. Never commit real secrets.
DINGTALK_APP_ID=replace-with-app-id
DINGTALK_AGENT_ID=replace-with-agent-id
DINGTALK_APP_KEY=replace-with-client-id
DINGTALK_APP_SECRET=replace-with-rotated-client-secret
# A user/union identity that has access to the AI Table Base.
DINGTALK_AITABLE_OPERATOR_ID=replace-with-operator-id
# Required in production. Use a separate long random value and do not reuse another token.
DINGTALK_CALLBACK_TOKEN=replace-with-a-long-random-callback-token

AITABLE_BASE_ID=replace-with-base-id
BI_CENTER_BASE_URL=http://bi-center:39054
BI_CENTER_API_TOKEN=replace-with-independent-employee-directory-token

# Teambition read-only task board. Use the same values as bi_center's production
# TEAMBITION_* settings; credentials remain server-side and are never returned by APIs.
TEAMBITION_SYNC_ENABLED=false
TEAMBITION_SOURCE=native
TEAMBITION_OPEN_API_BASE=https://open.teambition.com/api
TEAMBITION_OPEN_APP_ID=
TEAMBITION_OPEN_APP_SECRET=
TEAMBITION_OPEN_ORGANIZATION_ID=
# Only needed when TEAMBITION_SOURCE=dingtalk. Empty values fall back to this
# service's DINGTALK_APP_KEY / DINGTALK_APP_SECRET.
TEAMBITION_DINGTALK_APP_KEY=
TEAMBITION_DINGTALK_APP_SECRET=
TEAMBITION_OPEN_REQUEST_TIMEOUT=20

# OpenAI-compatible Chat Completions endpoint. Empty values use deterministic fallback summaries.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_PROVIDER=
AI_INCLUDE_PERSON_NAMES=false
AI_MAX_ITEMS=120
AI_MAX_TEXT_CHARS=600

DATABASE_PATH=runtime/weekly_report_assistant.db
ARTIFACT_DIR=runtime/reports
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=30
HTTP_TIMEOUT_SECONDS=30
